  <Target Name="Sphere10Framework:Make"><MSBuild Projects="Sphere10Framework.dproj" Targets="Make" /></Target>
  <Target Name="Build"><CallTarget Targets="Sphere10PascalFramework;Sphere10Framework" /></Target>
  <Target Name="Clean"><CallTarget Targets="Sphere10PascalFramework:Clean;Sphere10Framework:Clean" /></Target>
  <Target Name="Make"><CallTarget Targets="Sphere10PascalFramework:Make;Sphere10Framework:Make" /></Target>
  <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')" />
