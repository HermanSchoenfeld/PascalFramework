<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="4">
    <PathDelim Value="\"/>
    <Name Value="Sphere10Framework"/>
    <Type Value="RunAndDesignTime"/>
    <Description Value="Sphere10 Pascal Framework cache, wizard, collections, data and visual grid components."/>
