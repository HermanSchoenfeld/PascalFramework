<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ProjectGuid>{F34DB825-62DF-40E9-A46D-FF5E57373D4E}</ProjectGuid>
    <MainSource>ThrottleDemo.dpr</MainSource>
    <Config Condition="'$(Config)'==''">Debug</Config>
    <Platform Condition="'$(Platform)'==''">Win64</Platform>
    <Base>True</Base>
    <TargetedPlatforms>3</TargetedPlatforms>
    <AppType>Application</AppType>
    <FrameworkType>VCL</FrameworkType>
    <ProjectVersion>20.3</ProjectVersion>
    <DCC_Namespace>System;Winapi;Vcl;Vcl.Imaging;Data;Xml</DCC_Namespace>
    <DCC_UnitAlias>Generics.Collections=System.Generics.Collections;Generics.Defaults=System.Generics.Defaults;$(DCC_UnitAlias)</DCC_UnitAlias>
    <DCC_UnitSearchPath>..\..\src\Sphere10;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
    <DCC_IncludePath>..\..\src\Sphere10;$(DCC_IncludePath)</DCC_IncludePath>
    <DCC_ResourcePath>..\..\lib\Delphi\$(Platform)\throttle-demo\$(Config)\res;..\..\src\Sphere10;$(DCC_ResourcePath)</DCC_ResourcePath>
    <DCC_DcuOutput>..\..\lib\Delphi\$(Platform)\throttle-demo\$(Config)\obj</DCC_DcuOutput>
    <DCC_ExeOutput>..\..\lib\Delphi\$(Platform)\throttle-demo\$(Config)</DCC_ExeOutput>
    <BRCC_OutputDir>..\..\lib\Delphi\$(Platform)\throttle-demo\$(Config)\res</BRCC_OutputDir>
    <BRCC_IncludePath>..\..\src\Sphere10;$(BRCC_IncludePath)</BRCC_IncludePath>
    <DCC_RangeChecking>true</DCC_RangeChecking>
    <DCC_IntegerOverflowCheck>true</DCC_IntegerOverflowCheck>
  </PropertyGroup>
  <ItemGroup>
    <RcCompile Include="..\..\src\Sphere10\UVisualGrid.VCL.rc" />
    <DelphiCompile Include="$(MainSource)"><MainSource>MainSource</MainSource></DelphiCompile>
    <DCCReference Include="UThrottleDemo.pas" />
    <BuildConfiguration Include="Base"><Key>Base</Key></BuildConfiguration>
    <BuildConfiguration Include="Debug"><Key>Debug</Key><CfgParent>Base</CfgParent></BuildConfiguration>
    <BuildConfiguration Include="Release"><Key>Release</Key><CfgParent>Base</CfgParent></BuildConfiguration>
  </ItemGroup>
  <ProjectExtensions>
    <Borland.Personality>Delphi.Personality.12</Borland.Personality>
    <BorlandProject>
      <Delphi.Personality><Source><Source Name="MainSource">ThrottleDemo.dpr</Source></Source></Delphi.Personality>
      <Platforms><Platform value="Win32">True</Platform><Platform value="Win64">True</Platform></Platforms>
    </BorlandProject>
  </ProjectExtensions>
  <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets" />
</Project>
